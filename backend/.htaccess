RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route API requests
RewriteRule ^api/products/?$ api/products.php [L,QSA]
RewriteRule ^api/products/(\d+)$ api/products.php?id=$1 [L,QSA]
RewriteRule ^api/auth/?$ api/auth.php [L,QSA]
RewriteRule ^api/orders/?$ api/orders.php [L,QSA]
RewriteRule ^api/cart/?$ api/cart.php [L,QSA]
RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
